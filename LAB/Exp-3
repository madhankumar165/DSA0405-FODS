import numpy as np

house_data = np.array([
    [3, 1200, 200000],
    [5, 1800, 350000],
    [6, 2200, 450000],
    [4, 1500, 280000],
    [5, 2000, 400000]
])

filtered_houses = house_data[house_data[:, 0] > 4]
average_price = np.mean(filtered_houses[:, 2])

print("Average Sale Price:", average_price)
